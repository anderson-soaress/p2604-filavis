{
  "name": "filavis-p3",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "test": "npm run test -w backend",
    "test:unit": "npm run test:unit -w backend",
    "test:api": "npm run test:api -w backend",
    "test:coverage": "npm run test:coverage -w backend",
    "lint": "npm run lint -w backend && npm run lint -w frontend",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:deploy": "npm run db:deploy -w backend",
    "db:seed": "npm run db:seed -w backend"
  },
  "devDependencies": {"concurrently": "^9.1.2"}
}
